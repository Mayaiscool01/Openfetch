# Maintainer: Mayaiscool01
pkgname=openfetch
pkgver=0.5.0
pkgrel=1
pkgdesc='Fast, customisable system information and visualisation tool'
arch=('x86_64' 'aarch64')
url='https://github.com/Mayaiscool01/Openfetch'
license=('MIT')
depends=('gcc-libs')
makedepends=('cargo')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "$pkgname-$pkgver"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname-$pkgver"
  cargo test --frozen
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/openfetch "$pkgdir/usr/bin/openfetch"
  install -Dm644 src/default_config.toml "$pkgdir/usr/share/openfetch/config.toml"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
